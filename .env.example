# Copia este archivo a .env.local y rellena con tus valores (nunca subas .env.local a Git)

# MongoDB — la URI incluye host, usuario, clave y NOMBRE DE BASE al final del path
# Local: mongodb://localhost:27017/bowling-quetral-menu
# Atlas: mongodb+srv://USUARIO:CLAVE@cluster.xxxxx.mongodb.net/NOMBRE_DB?retryWrites=true&w=majority
MONGODB_URI=

# Opcional: copiar catálogo de lib/carta a la base → npm run seed:carta

# Cloudinary (subida de imágenes; opcional hasta que conectes el uploader)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Zona horaria del local (Happy Hour). IANA; no uses TZ (reservada en Vercel).
APP_TIMEZONE=America/Santiago

# Panel admin (obligatorio para usar /admin)
# AUTH_SECRET: firma la cookie de sesión (mín. 16 caracteres). Generar: openssl rand -base64 32
# ADMIN_USERNAME / ADMIN_PASSWORD: único usuario del panel (sin base de datos de usuarios)
# En desarrollo, credenciales reales en ACCESO-ADMIN.local.md (no se sube a Git)
AUTH_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
